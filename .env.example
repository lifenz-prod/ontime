# Planning Center Online credentials
#
# These are a Personal Access Token, NOT a user login.
# Create the pair at https://api.planningcenteronline.com/oauth/applications
#   -> "Personal Access Tokens" -> "Create one now"
# It needs read access to Services.
#
# This file is gitignored. Do not commit it.

PCO_APP_ID=your-application-id
PCO_SECRET=your-secret

# Optional: skip the service-type lookup by pinning the one you want.
# The probe prints every service type id on startup.
PCO_SERVICE_TYPE_ID=

# Optional: overrides the timezone in pco-rules.json
PCO_TIMEZONE=Pacific/Auckland
