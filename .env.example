# Planning Center Online credentials
#
# You do not need this file: credentials are normally entered under
# Planning Center in Ontime's app settings, which stores them on the machine and
# checks them before saving. This is here for headless setups and for development.
#
# These are a Personal Access Token, NOT a user login.
# Create the pair at https://api.planningcenteronline.com/oauth/applications
#   -> "Personal Access Tokens" -> "Create one now"
# It needs read access to Services.
#
# Credentials saved in the settings panel take precedence over these.
# A .env is also read from the Ontime data directory, next to pco-rules.json.
#
# This file is gitignored. Do not commit it.

PCO_APP_ID=your-application-id
PCO_SECRET=your-secret

# Credentials alone do not answer recalls: turn on "Offer plans to Companion and
# OSC" in the settings panel ("enabled" in pco-rules.json). Planning Center is
# then listed alongside the Google Sheet tabs, not instead of them.

# Optional: skip the service-type lookup by pinning the one you want.
# The server logs the one it resolved, and the probe prints every id.
# Can also be set as serviceTypeId / serviceTypeName in pco-rules.json.
PCO_SERVICE_TYPE_ID=

# Optional: overrides the timezone in pco-rules.json
PCO_TIMEZONE=Pacific/Auckland
