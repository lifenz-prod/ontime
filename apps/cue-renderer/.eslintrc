{
  "parserOptions": {
    "sourceType": "script"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "plugins": [],
  "rules": {
    "@typescript-eslint/no-var-requires": "off",
    "@typescript-eslint/no-require-imports": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.js"],
      "parserOptions": {
        "sourceType": "module"
      }
    }
  ]
}
